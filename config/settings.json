{
  "site": {
    "name": "AuNews",
    "tagline": "বাংলাদেশ ও বিশ্বের সব খবর, এক জায়গায়",
    "taglineEn": "All the news from Bangladesh and the world, in one place",
    "url": "https://aunews.vercel.app",
    "contact": "",
    "social": {
      "facebook": "",
      "telegram": ""
    }
  },
  "retention": {
    "days": 1,
    "mode": "rolling"
  },
  "ingest": {
    "intervalMinutes": 30,
    "maxItemsPerFeedPerRun": 30,
    "summaryMaxChars": 280,
    "windowDays": 3
  },
  "snapshot": {
    "perCategory": 80,
    "all": 400,
    "summaryChars": 160
  },
  "display": {
    "defaultLanguage": "bn",
    "showSourceAttribution": true
  },
  "cluster": {
    "threshold": 0.45,
    "minShared": 2,
    "maxHoursApart": 48,
    "trendingMinSources": 2,
    "trendingWindowHours": 24,
    "trendingLimit": 30
  },
  "ai": {
    "enabled": true,
    "provider": "groq",
    "model": "openai/gpt-oss-120b",
    "batchSize": 10,
    "maxRequestsPerRun": 4,
    "dailyRequestBudget": 300,
    "dailyTokenBudget": 170000,
    "tokensPerMinute": 8000,
    "translateSummary": false
  },
  "reader": {
    "enabled": true,
    "externalSources": [
      "nyt-world"
    ]
  },
  "digest": {
    "enabled": true,
    "model": "openai/gpt-oss-20b",
    "windowHours": 24,
    "minSources": 3,
    "minSourcesWithText": 2,
    "maxSources": 3,
    "maxCharsPerSource": 1400,
    "minCharsPerSource": 250,
    "maxPerRun": 2,
    "maxCandidatesPerRun": 6,
    "dailyMax": 20,
    "dailyTokenBudget": 150000,
    "tokensPerMinute": 8000,
    "retryAfterHours": 3,
    "keep": 60
  },
  "info": {
    "weather": {
      "enabled": true,
      "name": "ঢাকা",
      "lat": 23.81,
      "lon": 90.41
    },
    "fx": {
      "enabled": true,
      "base": "USD",
      "quote": "BDT"
    }
  },
  "daily": {
    "enabled": true,
    "hourDhaka": 7,
    "minStories": 3,
    "maxStories": 10,
    "minSources": 2,
    "windowHours": 24,
    "maxWorld": 4,
    "keep": 1
  },
  "telegram": {
    "enabled": true,
    "maxAgeHours": 6,
    "maxPerRun": 3,
    "dailyMax": 25,
    "delayMs": 1500,
    "maxTries": 3
  },
  "facebook": {
    "enabled": true,
    "intervalMinutes": 60,
    "maxAgeHours": 12,
    "dailyMax": 30,
    "maxTries": 3,
    "maxAttempts": 2,
    "fallbackToNews": true,
    "newsMinSources": 2,
    "requirePhoto": true,
    "hashtags": [
      "#AuNews"
    ],
    "apiVersion": "v25.0"
  },
  "matches": {
    "enabled": true,
    "football": {
      "competitions": [
        "WC",
        "CL",
        "PL",
        "PD",
        "SA",
        "BL1"
      ],
      "maxResults": 8,
      "maxUpcoming": 6
    },
    "cricket": {
      "featuredTeams": [
        "Bangladesh",
        "India",
        "Pakistan",
        "Australia",
        "England",
        "South Africa",
        "New Zealand",
        "Sri Lanka",
        "Afghanistan",
        "West Indies"
      ],
      "maxResults": 8,
      "maxUpcoming": 6
    }
  }
}
