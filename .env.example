# ---- Vercel → Project → Settings → Environment Variables ----
# (ঐচ্ছিক) আপনার রিপো, যেমন: miftahulislam/AuNews — না দিলে Vercel নিজের Git তথ্য থেকে নেয়
DATA_REPO=
# শুধু রিপো PRIVATE হলে: GitHub → Settings → Developer settings → Fine-grained token
# (শুধু এই রিপো, Contents: Read-only)
DATA_GITHUB_TOKEN=

# ---- GitHub → Settings → Secrets and variables → Actions (ঐচ্ছিক) ----
# ইংরেজি খবরের বাংলা অনুবাদ (Groq)
GROQ_API_KEY=

# ---- GitHub → Settings → Secrets and variables → Actions → Variables (ঐচ্ছিক) ----
# এআই ব্রিফের মডেল (না দিলে config/settings.json এর digest.model)
GROQ_DIGEST_MODEL=

# টেলিগ্রাম অটো-পোস্ট (README দেখুন)
# Secret: TELEGRAM_BOT_TOKEN   |   Variables: TELEGRAM_CHAT_ID (যেমন @aunews_bd), TELEGRAM_DRY_RUN=1 (শুধু পরীক্ষা), SITE_URL (ঐচ্ছিক)

# ---- Vercel → Environment Variables: "দ্রুত" পেজের ম্যাচ (ঐচ্ছিক; না দিলে config/matches.json এর হাতে-দেওয়া তালিকা) ----
# ফুটবল: football-data.org এ ফ্রি অ্যাকাউন্ট খুলে API token নিন
FOOTBALL_DATA_KEY=
# ক্রিকেট: cricketdata.org এ ফ্রি অ্যাকাউন্ট খুলে API key নিন (ফ্রিতে দিনে ১০০ কল)
CRICAPI_KEY=
